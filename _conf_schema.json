{
    "group_msg_history": {
        "description": "输入给大模型的消息数量",
        "type": "int",
        "hint": "决定了会输入给大模型多少条q群历史消息(最多200条)",
        "default": 20
    },
    "enable_all_groups": {
        "description": "回复所有群聊",
        "type": "bool",
        "hint": "开启后将回复所有群聊（黑名单中的群除外）。关闭则只回复白名单中的群。",
        "default": false
    },
    "enabled_groups": {
        "description": "启用回复功能的群聊列表",
        "type": "list",
        "items": {"type": "string"},
        "hint": "只有在这个列表中的群聊才会启用回复功能，如果为空则不启用回复功能",
        "default": []
    },
    "blocked_groups": {
        "description": "黑名单群组列表",
        "type": "list",
        "items": {"type": "string"},
        "hint": "列表中的群聊将不会回复，优先级高于白名单和全局开关。",
        "default": []
    },
    "enabled_private": {
        "description": "启用私聊回复功能",
        "type": "bool",
        "hint": "是否开启私聊回复功能",
        "default": false
    },
    "filter_thinking": {
        "description": "过滤思考过程",
        "type": "bool",
        "hint": "是否过滤大模型回复中被<think></think>标签包裹的思考内容",
        "default": true
    },
    "read_air":{
        "description":"是否开启读空气",
        "type":"bool",
        "hint":"开启后会根据群聊消息自动判断是否需要回复，建议提示好 AI 在什么情况下回复。legacy 模式下本插件请求会等待完整生成后再发送，确保读空气判断和引用回复生效，不修改 AstrBot 全局流式设置。",
        "default":false
    },
    "autonomous_reply_prompt": {
        "description": "自主回复附加提示词",
        "type": "object",
        "hint": "仅追加到本插件本次请求，覆盖概率/关键词回复、model 编排和 /sc callllm；不修改 AstrBot 人格。",
        "items": {
            "enabled": {
                "description": "启用附加提示词",
                "type": "bool",
                "default": false
            },
            "text": {
                "description": "自定义附加提示词",
                "type": "text",
                "hint": "可填写多行群聊参与规则。留空不生效。读空气、JSON 输出协议和引用规则仍由插件追加，请勿要求与之冲突的输出格式。",
                "default": ""
            }
        }
    },
    "smart_quote":{
        "description":"模型自主引用消息",
        "type":"bool",
        "hint":"开启后模型可以像人一样引用它回应的消息。AstrBot 的「回复时引用发送人消息」关闭时，由模型决定是否引用、引用哪条；开启时每条回复都会引用，由模型决定引用哪条，避免总是引用触发回复的消息而错位。需要 AstrBot v4.19.3 及以上，流式输出时不生效",
        "default":true
    },
    "use_func_tool":{
        "description":"是否启用函数工具",
        "type":"bool",
        "hint":"开启后大模型会调用提供的函数工具",
        "default":false
    },
    "model_frequency":{
        "description":"决定调用模型回复的频率",
        "type":"object",
        "items":{
            "keywords":{
                "description":"让模型回复的关键词",
                "hint":"如果消息中包含这些关键词，则调用模型回复，留空则不启用该功能",
                "type":"list",
                "default":[]
            },
            "blacklist_keywords": {
                "description": "黑名单关键词",
                "type": "list",
                "hint": "如果消息中任意位置包含这些关键词，则不回复。不要用 / 屏蔽指令，否则网址也会命中；请将 / 填入「忽略的指令前缀」。",
                "default": []
            },
            "ignored_prefixes": {
                "description": "忽略的指令前缀",
                "type": "list",
                "hint": "去掉消息开头空白后，仅匹配开头。可填写 /、! 等；/help 会跳过，https://example.com 和正文中的 / 不会因此跳过。仅控制本插件自主回复，不阻止指令执行。默认空列表，不过滤。请从黑名单关键词移除对应前缀。",
                "default": []
            },
            "method":{
                "type":"string",
                "description":"使用什么方式决定是否调用模型",
                "hint":"目前仅支持概率回复",
                "default":"概率回复",
                "options":["概率回复"]
            },
            "probability":{
                "description":"概率回复相关，仅在设置为概率回复时有效",
                "type":"object",
                "items":{
                    "probability":{
                        "type":"float",
                        "description":"回复概率",
                        "hint":"填写回复概率,范围为0-1之间的小数,如0.1表示10%的概率回复,1表示100%回复",
                        "default":0.1
                    }
                }
            }
        }
    },
    "image_processing":{
        "description":"图片处理相关配置",
        "type":"object",
        "items":{
            "image_count":{
                "description":"历史记录中直接输入给大模型的图片数量",
                "type":"int",
                "hint":"决定从历史记录中额外直接输入给大模型多少张图片(最新的优先)。当前消息本身及其引用消息中的图片始终会提供，不受此项限制。仅限支持图片输入的多模态模型可用(和下面的图像转述功能可以同时开启)",
                "default":0
            },
            "image_context_messages":{
                "description":"图片关联上下文消息数",
                "type":"int",
                "hint":"向前查看最近多少条聊天记录来寻找图片，供大模型判断当前消息是否与某张图片相关。设为0可关闭。当前消息及其引用消息中的图片始终会提供",
                "default":10
            },
            "image_context_max_images":{
                "description":"上下文图片数量上限",
                "type":"int",
                "hint":"在上面的上下文消息范围内，最多额外提供多少张图片。图片会带上 [图片#编号] 标记，由大模型自行判断哪些图片与当前对话相关",
                "default":5
            },
            "use_image_caption": {
                "type": "bool",
                "description": "图像转述(需要模型支持)",
                "hint": "用模型将聊天中的图片描述为文字，作为上下文输入",
                "default": false
            },
            "image_caption_provider_id": {
                "type": "string",
                "description": "图像转述提供商ID",
                "hint": "可选，图像转述提供商ID，如为空则使用当前选择的提供商",
                "default": ""
            },
            "image_caption_prompt": {
                "type": "string",
                "description": "图像转述提示词",
                "hint": "用于描述图像转述的提示词，根据你的token预算来调整",
                "default": "请直接简短描述这张图片"
            },
            "image_caption_concurrency": {
                "type": "int",
                "description": "图像转述并发数",
                "hint": "所有会话合计同时进行的图像转述请求数量。过低会排队，过高可能触发提供商限流，建议 3-5",
                "default": 3
            },
            "enable_image_persistence": {
                "type": "bool",
                "description": "是否开启图片持久化存储",
                "hint": "开启后会将聊天中的图片保存到本地，用于解决图片过期的问题",
                "default": true
            },
            "image_retention_days": {
                "type": "int",
                "description": "持久化存储的图片保留天数",
                "hint": "超过此天数的图片将被自动清理",
                "default": 7
            }
        }
    },
    "forward_processing": {
        "description": "合并转发消息处理",
        "type": "object",
        "items": {
            "parse_forward": {
                "type": "bool",
                "description": "解析合并转发消息",
                "hint": "开启后会把合并转发展开为带发送者的聊天记录输入给模型。需要协议端支持 get_forward_msg（aiocqhttp/NapCat 等），获取失败时自动回退为占位符；会产生额外的协议端请求，建议按需开启",
                "default": false
            },
            "max_depth": {
                "type": "int",
                "description": "合并转发解析层数",
                "hint": "最多展开多少层嵌套的合并转发，层数越高 token 消耗越大",
                "default": 2
            },
            "max_nodes": {
                "type": "int",
                "description": "单次展开消息条数上限",
                "hint": "每条合并转发最多读取多少条消息，超出部分会提示还有多少条未显示",
                "default": 50
            },
            "max_chars": {
                "type": "int",
                "description": "合并转发文本长度上限",
                "hint": "单条合并转发展开后最多输入给模型多少字符，超出会自动截断",
                "default": 2000
            },
            "fetch_timeout": {
                "type": "int",
                "description": "合并转发获取超时（秒）",
                "hint": "调用 get_forward_msg 的最长等待时间，超时后回退为占位符",
                "default": 5
            }
        }
    },
    "reply_orchestration": {
        "description": "并发回复编排",
        "type": "object",
        "hint": "默认关闭。开启后先做规则门控，再用指定 provider 进行一次 JSON 决策/生成，最后按账号节奏发送。",
        "items": {
            "enabled": {
                "description": "启用并发回复编排",
                "type": "bool",
                "hint": "关闭时完全走 legacy 行为",
                "default": false
            },
            "decision_mode": {
                "description": "决策模式",
                "type": "string",
                "hint": "legacy 保持 read_air；model 使用 JSON 决策协议",
                "default": "legacy",
                "options": ["legacy", "model"]
            },
            "provider_id": {
                "description": "决策模型提供商 ID",
                "type": "string",
                "hint": "留空使用当前会话 provider；非空时必须存在且支持文本生成",
                "default": ""
            },
            "max_parallel": {
                "description": "全局最大并发生成数",
                "type": "int",
                "hint": "10+ 群建议 12-16，并低于 provider 的并发限制",
                "default": 12
            },
            "timeout_ms": {
                "description": "单次生成超时（毫秒）",
                "type": "int",
                "hint": "覆盖等待并发信号量和 provider 调用；超时按 ignore 处理",
                "default": 2000
            },
            "max_in_progress_ms": {
                "description": "in-progress 兜底超时（毫秒）",
                "type": "int",
                "hint": "必须大于 timeout_ms，防止异常路径永久锁死",
                "default": 15000
            },
            "max_context_messages": {
                "description": "决策请求最多携带的历史消息数",
                "type": "int",
                "hint": "越大越慢，建议不超过 20",
                "default": 20
            },
            "max_reply_messages": {
                "description": "一次回复最多包含几条消息",
                "type": "int",
                "hint": "多条会合并成一个 MessageChain 发送",
                "default": 3
            },
            "min_confidence": {
                "description": "最低回复置信度",
                "type": "float",
                "hint": "低于该值按 ignore 处理，范围 0-1",
                "default": 0.55
            },
            "cooldown_ms": {
                "description": "同一聊天回复冷却（毫秒）",
                "type": "int",
                "hint": "硬限制，模型无法绕过",
                "default": 3000
            },
            "max_replies_per_minute": {
                "description": "同一聊天每分钟最多回复次数",
                "type": "int",
                "hint": "硬限制，模型无法绕过",
                "default": 6
            },
            "fallback_on_error": {
                "description": "失败降级策略",
                "type": "string",
                "hint": "v1 仅支持 ignore",
                "default": "ignore",
                "options": ["ignore"]
            },
            "outbound_queue": {
                "description": "账号级发送队列",
                "type": "object",
                "hint": "关闭时生成完成后立即发送；开启时按全局/群级间隔发送",
                "items": {
                    "enabled": {
                        "description": "启用发送队列",
                        "type": "bool",
                        "hint": "关闭时仍通过同一个 sender 立即发送并保存历史",
                        "default": false
                    },
                    "global_interval_ms": {
                        "description": "账号级全局发送间隔（毫秒）",
                        "type": "int",
                        "hint": "不同群共享同一账号时也不会同时爆发",
                        "default": 800
                    },
                    "per_group_interval_ms": {
                        "description": "单群发送间隔（毫秒）",
                        "type": "int",
                        "hint": "同一群连续回复的最小间隔",
                        "default": 6000
                    },
                    "jitter_ms": {
                        "description": "发送随机抖动（毫秒）",
                        "type": "int",
                        "hint": "在入队时加入 0 到该值的随机等待",
                        "default": 300
                    },
                    "max_burst": {
                        "description": "账号级最大突发数",
                        "type": "int",
                        "hint": "token bucket 容量",
                        "default": 3
                    },
                    "ttl_ms": {
                        "description": "队列项有效期（毫秒）",
                        "type": "int",
                        "hint": "过期直接丢弃，避免发送过时回复",
                        "default": 20000
                    },
                    "max_pending_per_group": {
                        "description": "单群最大待发送数",
                        "type": "int",
                        "hint": "超过后拒绝新的低优先级项",
                        "default": 2
                    },
                    "max_queue_size": {
                        "description": "队列总长度上限",
                        "type": "int",
                        "hint": "高优先级项可以替换最旧的低优先级项",
                        "default": 200
                    },
                    "send_retries": {
                        "description": "发送失败重试次数",
                        "type": "int",
                        "hint": "使用指数退避；最终失败丢弃并记录",
                        "default": 2
                    }
                }
            }
        }
    }
}
